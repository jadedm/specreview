# Block environment files, Wrangler's local secrets and private keys; examples
# with placeholders are the only exception.
if git diff --cached --name-only --diff-filter=d | grep -E '(^|/)(\.env|\.dev\.vars)|\.pem$' | grep -v '\.example$'; then
  echo "pre-commit: refusing to commit a secrets file (above)." >&2
  exit 1
fi
