{
  "name": "@specreview/hub",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p deploy/tsconfig.json",
    "test": "pnpm --filter @specreview/shared build && vitest run",
    "build": "wrangler deploy --dry-run --outdir dist && esbuild deploy/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/deploy.mjs --legal-comments=none"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "^5.20261007.1",
    "esbuild": "^0.25.12",
    "miniflare": "4.20260730.0",
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "jose": "6.2.12",
    "@specreview/shared": "workspace:*"
  }
}
